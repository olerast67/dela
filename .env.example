# Copy this file to .env and fill it in.

# The only address that can register first; this account becomes the administrator.
DELA_ADMIN_EMAIL=you@example.com

# Domain for the bundled HTTPS proxy. Its DNS A record must point to this server, ports 80 and 443 must be free.
DELA_DOMAIN=tasks.example.com

# Address the app is opened at. Needed for passkeys.
DELA_PUBLIC_URL=https://tasks.example.com

# true lets anyone register without an invite.
DELA_OPEN_REGISTRATION=false

# Daily database snapshots kept in /data/backups.
DELA_BACKUP_KEEP=7
