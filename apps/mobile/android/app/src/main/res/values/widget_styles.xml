<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="WidgetConfigLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textColor">#766F63</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="WidgetConfigOption">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">#25221C</item>
        <item name="android:textSize">16sp</item>
        <item name="android:buttonTint">#2E7D5B</item>
    </style>

    <style name="WidgetConfigTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">#2E7D5B</item>
        <item name="colorPrimaryDark">#1F5C42</item>
        <item name="colorAccent">#2E7D5B</item>
    </style>
</resources>
