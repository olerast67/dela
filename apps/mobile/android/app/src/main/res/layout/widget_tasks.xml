<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет «Задачи»: фон с настраиваемой прозрачностью, заголовок со списком и кнопкой «+», список. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_light"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <ImageView
                android:id="@+id/widget_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@mipmap/ic_launcher_round"
                android:contentDescription="Открыть Dela" />

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="8dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:textStyle="bold"
                android:textSize="17sp"
                android:text="Сегодня" />

            <ImageView
                android:id="@+id/widget_voice"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="9dp"
                android:src="@drawable/widget_mic"
                android:contentDescription="Задача голосом" />

            <ImageView
                android:id="@+id/widget_add"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="6dp"
                android:src="@drawable/widget_add"
                android:contentDescription="Добавить задачу" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/widget_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:paddingBottom="6dp"
                android:clipToPadding="false" />

            <TextView
                android:id="@+id/widget_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="16dp"
                android:textSize="15sp"
                android:text="На сегодня всё" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
