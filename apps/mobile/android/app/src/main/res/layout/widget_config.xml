<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cfg_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            style="@style/WidgetConfigLabel"
            android:text="@string/cfg_list" />

        <Spinner
            android:id="@+id/cfg_list"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <TextView
            style="@style/WidgetConfigLabel"
            android:text="@string/cfg_theme" />

        <RadioGroup
            android:id="@+id/cfg_theme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton android:id="@+id/cfg_theme_system" style="@style/WidgetConfigOption" android:text="@string/cfg_theme_system" />
            <RadioButton android:id="@+id/cfg_theme_light" style="@style/WidgetConfigOption" android:text="@string/cfg_theme_light" />
            <RadioButton android:id="@+id/cfg_theme_dark" style="@style/WidgetConfigOption" android:text="@string/cfg_theme_dark" />
        </RadioGroup>

        <TextView
            style="@style/WidgetConfigLabel"
            android:text="@string/cfg_opacity" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <SeekBar
                android:id="@+id/cfg_opacity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/cfg_opacity_value"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@color/cfg_text"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            style="@style/WidgetConfigLabel"
            android:text="@string/cfg_font" />

        <RadioGroup
            android:id="@+id/cfg_font"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton android:id="@+id/cfg_font_normal" style="@style/WidgetConfigOption" android:text="@string/cfg_font_normal" />
            <RadioButton android:id="@+id/cfg_font_large" style="@style/WidgetConfigOption" android:text="@string/cfg_font_large" />
        </RadioGroup>

        <CheckBox
            android:id="@+id/cfg_compact"
            style="@style/WidgetConfigOption"
            android:layout_marginTop="12dp"
            android:text="@string/cfg_compact" />

        <CheckBox
            android:id="@+id/cfg_hide_locked"
            style="@style/WidgetConfigOption"
            android:text="@string/cfg_hide_locked" />

        <Button
            android:id="@+id/cfg_done"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#2E7D5B"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:text="@string/cfg_done" />
    </LinearLayout>
</ScrollView>
