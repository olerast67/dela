{
  "name": "dela",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.18"
  },
  "imports": {
    "#core": "./packages/core/src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.sw.json",
    "check": "npm run typecheck && npm test",
    "server": "node --disable-warning=ExperimentalWarning apps/server/src/main.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "start": "node --disable-warning=ExperimentalWarning apps/server/src/main.ts",
    "test:e2e": "npm run build:web && playwright test",
    "desktop:dev": "cd apps/desktop && tauri dev",
    "desktop:build": "npm run build:web && cd apps/desktop && tauri build"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@playwright/test": "^1.64.0",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/cli": "^2.12.2",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-notification": "^2.6.0",
    "@tauri-apps/plugin-opener": "^2.7.1",
    "@types/libsodium-wrappers-sumo": "^0.8.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "fast-check": "^4.10.2",
    "ical.js": "2.2.1",
    "idb": "^8.0.4",
    "marked": "18.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.4",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "10.0.0",
    "@capacitor/haptics": "8.0.2",
    "@fontsource-variable/manrope": "5.3.0",
    "@hono/node-server": "2.1.5",
    "@simplewebauthn/server": "14.0.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.3",
    "hono": "^4.13.13",
    "libsodium-wrappers-sumo": "^0.8.4",
    "ws": "8.22.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
